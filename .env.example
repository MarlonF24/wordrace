DB_HOST=localhost
DB_PORT=5432
DB_NAME=wordrace
DB_USER=username
DB_PASSWORD=password

DATA_SCHEMA=public
DICT_SCHEMA=dictionary

# Local dictionary regeneration only; production restores a database dump.
SEED_DATA_PATH=/path/to/your/dictionary.jsonl
SEARCH_AGENT_URL=http://localhost:8000
SEARCH_AGENT_PORT=8000
API_HOST=127.0.0.1
API_PORT=8000

# Production follows the per-app main tags; SHA tags remain available for rollback.
NEXTJS_APP_IMAGE=ghcr.io/owner/wordrace/nextjs:main
SEARCH_AGENT_APP_IMAGE=ghcr.io/owner/wordrace/search-agent:main

DOMAIN=wordrace.example.com
CADDY_EMAIL=admin@example.com
